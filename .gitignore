# =============================================================================
# Dog Breeds Classification — .gitignore
# Project ID: PRAICP-1007-120
# =============================================================================

# Virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Temporary IDE / Code Runner files (Unwanted artifacts)
tempCodeRunnerFile.py
*.tempCodeRunnerFile.py
.vscode/
.idea/
*.code-workspace

# Large model archives & raw tarballs
*.tar
*.tar.gz
*.tgz
*.zip

# Dataset (never commit raw images to Git)
dog-breed-120/
data/raw/
train/
test/

# Uploaded user images (keep folder via .gitkeep)
dog_photos/uploaded/*
!dog_photos/uploaded/.gitkeep

# Trained models & heavy checkpoints (too large for Git)
model/checkpoints/*.keras
model/checkpoints/*.h5
model/saved_models/*.keras
artifacts/models/*.keras
artifacts/models/*.h5
artifacts/models/*.pb

# Training logs & telemetry
log/tensorboard/
log/training/*.log
log/application/*.log
mlruns/

# Jupyter checkpoints
.ipynb_checkpoints/
*.ipynb_checkpoints

# Output files
outputs/

# Secrets & environment
.env
*.env

# Windows system files
Thumbs.db
desktop.ini
*.lnk

# macOS system files
.DS_Store

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Testing & quality caches
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.ruff_cache/
